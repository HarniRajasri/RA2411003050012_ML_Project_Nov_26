# ---- KHorizon configuration (copy to .env and edit; .env is git-ignored) ----
# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///data/khorizon.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# Optional shared key. If set, ESP32/simulator must send header X-KH-Key with this value.
DEVICE_API_KEY=

# Connectivity (seconds)
HEARTBEAT_INTERVAL=5
DEVICE_TIMEOUT=15
# Devices that join within this many seconds of START CLASS still count as "continuous from start"
JOIN_GRACE_SECONDS=60

# Motion / attention estimation (see docs/architecture.md)
MOTION_THRESHOLD=0.35
DRIFT_THRESHOLD=0.45
# Length of one analytics window. 600 = 10 minutes. (Start Class dialog can override, e.g. 60 s for demos.)
ENGAGEMENT_WINDOW_SECONDS=600

# EEG software-in-the-loop: OFF | DATASET_REPLAY | PHYSICAL_EEG
EEG_MODE=OFF
# CSV produced by eeg/feature_extraction.py (relative paths resolve from the project root)
EEG_REPLAY_FILE=data/eeg_features/sub-01_ses-01.csv
EEG_REPLAY_STEP_SECONDS=2
# Only this device receives EEG-derived evidence in fusion. Empty = every REAL device.
EEG_TARGET_DEVICE=KH-S01

# Fusion weights (motion vs EEG). Normalised internally.
FUSION_W_MOTION_MOVING=0.75
FUSION_W_EEG_MOVING=0.25
FUSION_W_MOTION_STABLE=0.30
FUSION_W_EEG_STABLE=0.70

# ---- Frontend (only needed when running the Vite dev server against a non-default backend) ----
VITE_API_URL=
VITE_WS_URL=

# ---- ESP32 ----
# Wi-Fi / backend URL / device ID are set in esp32/KHorizon_Headband/secrets.h (never committed):
#   WIFI_SSID, WIFI_PASSWORD, BACKEND_URL, DEVICE_ID_OVERRIDE
